OPENAI_API_KEY=
JURYAI_MODEL=gpt-5.6
JURYAI_REASONING_EFFORT=medium
# Runtime persistence selection is explicit. Production should use postgres;
# memory is for deterministic local/unit tests only.
JURYAI_PERSISTENCE_ADAPTER=postgres
JURYAI_DATABASE_URL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Generated outputs are written under artifacts/ and ignored by git.
# Live extraction requests set store=false and remain shadow-mode only.
# Human review remains authoritative for every extracted record.
# CI never calls a live model API.
