OPENAI_API_KEY=
JURYAI_MODEL=gpt-5.6
JURYAI_REASONING_EFFORT=medium
# Runtime persistence selection is explicit. Production should use postgres;
# memory is for deterministic local/unit tests only.
JURYAI_PERSISTENCE_ADAPTER=postgres
JURYAI_DATABASE_URL=
# Step 63.5 same-origin web shell. Production requires an HTTPS origin.
JURYAI_PUBLIC_ORIGIN=https://juryai-project-hostname.example
JURYAI_SUPABASE_URL=https://project-ref.supabase.co
JURYAI_SUPABASE_PUBLISHABLE_KEY=
# The server validates this optional documentation value against its frozen
# code constant; the browser never supplies or selects a disclosure version.
JURYAI_DISCLOSURE_VERSION=juryai-p2-disclosure-v0.1.0
# P2 server-side semantic compiler configuration.
JURYAI_COMPILER_API_KEY=
JURYAI_COMPILER_MODEL=gpt-5.6-sol
JURYAI_COMPILER_OMIT_SAMPLING_PARAMS=1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Generated outputs are written under artifacts/ and ignored by git.
# Live extraction requests set store=false and remain shadow-mode only.
# Human review remains authoritative for every extracted record.
# CI never calls a live model API.
