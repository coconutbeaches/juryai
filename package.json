{
  "name": "juryai-extraction-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "test": "vitest run --exclude src/tests/webmcp-persistence.test.ts --exclude src/tests/v2-1-persistence.test.ts --exclude src/tests/v2-1-invitation-persistence.test.ts --exclude src/tests/v2-1-1-persistence.test.ts --exclude src/tests/v2-1-1-invitation-persistence.test.ts --exclude src/tests/v2-1-1-party-review-persistence.test.ts --exclude src/tests/v2-1-2-disclosure-review-persistence.test.ts --exclude src/tests/v2-1-2-production-persistence.test.ts --exclude src/tests/v2-1-3-production-persistence.test.ts",
    "test:persistence": "vitest run src/tests/webmcp-persistence.test.ts src/tests/v2-1-persistence.test.ts src/tests/v2-1-invitation-persistence.test.ts",
    "test:persistence:v211": "vitest run src/tests/v2-1-1-persistence.test.ts src/tests/v2-1-1-invitation-persistence.test.ts src/tests/v2-1-1-party-review-persistence.test.ts src/tests/v2-1-2-disclosure-review-persistence.test.ts src/tests/v2-1-2-production-persistence.test.ts",
    "test:person-a": "vitest run src/tests/person-a-validation.test.ts src/tests/person-a-evaluation.test.ts src/tests/openai-responses.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "validate:golden": "tsx src/validation/validate-case-record.ts src/fixtures/dry_run_001.golden.json",
    "freeze:gate-zero-corpus": "tsx src/commands/freeze-gate-zero-corpus.ts --write",
    "validate:gate-zero-corpus": "tsx src/commands/freeze-gate-zero-corpus.ts",
    "freeze:gate-zero-baseline": "tsx src/commands/run-gate-zero-baseline.ts --write",
    "validate:gate-zero-baseline": "tsx src/commands/run-gate-zero-baseline.ts",
    "baseline:gate-zero": "tsx src/commands/run-gate-zero-baseline.ts",
    "freeze:gate-zero-policy": "tsx src/commands/freeze-gate-zero-acceptance-policy.ts --write",
    "validate:gate-zero-policy": "tsx src/commands/freeze-gate-zero-acceptance-policy.ts",
    "check:ci-test-coverage": "tsx src/commands/check-ci-test-coverage.ts",
    "extract:person-a": "tsx src/commands/extract-person-a.ts",
    "provenance:person-a": "tsx src/commands/run-person-a-provenance.ts",
    "evaluate:person-a": "tsx src/commands/extract-person-a.ts --extraction artifacts/person-a/latest/extraction.json",
    "evaluate:person-a-acceptance": "tsx src/commands/evaluate-person-a-extraction-acceptance.ts",
    "gate:person-a-acceptance": "tsx src/commands/evaluate-person-a-extraction-acceptance.ts --gate --format human",
    "eval:compiler": "tsx src/commands/run-compiler-eval.ts",
    "eval:compiler-live": "tsx src/commands/run-compiler-eval.ts --live",
    "clarify:person-a": "tsx src/commands/generate-person-a-clarifications.ts",
    "simulate:clarification": "tsx src/commands/simulate-person-a-clarification-round.ts",
    "repair:person-a": "tsx src/commands/repair-person-a-extraction.ts",
    "plan:person-a-runtime": "tsx src/commands/plan-person-a-runtime.ts",
    "assess:person-a-runtime": "tsx src/commands/assess-person-a-runtime.ts",
    "apply:person-a-clarifications": "tsx src/commands/apply-person-a-clarification-answers.ts",
    "confirm:person-a-record": "tsx src/commands/confirm-person-a-record.ts",
    "resolve:person-a-challenges": "tsx src/commands/resolve-person-a-challenges.ts",
    "format:check": "prettier --check .",
    "test:persistence:v213": "vitest run src/tests/v2-1-3-production-persistence.test.ts",
    "eval:compiler:absence": "vitest run src/tests/v2-1-3-explicit-absence.test.ts -t \"compiler replay corpus\""
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "pg": "8.23.0"
  }
}
